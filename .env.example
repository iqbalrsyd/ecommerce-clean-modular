# server
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://localhost:5432/ecom
REDIS_URL=redis://localhost:6379

# secrets — at least 32 chars, generated via: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-char-random-secret-please
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# CORS — comma-separated allowlist of FE origins
CORS_ORIGINS=http://localhost:5173

# rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
