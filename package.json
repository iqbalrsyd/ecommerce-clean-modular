{
  "name": "ecommerce-modular-monolith-clean",
  "version": "1.0.0",
  "private": true,
  "description": "Modular monolith (client + server apps) e-commerce. Clean best-practice reference implementation.",
  "workspaces": [
    "client-app",
    "server-app",
    "modules/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node server-app/src/index.js",
    "dev:client": "node client-app/scripts/dev.js",
    "build:server": "node scripts/build-server.js",
    "build:client": "node client-app/scripts/build.js",
    "build": "npm run build:server && npm run build:client",
    "start": "node server-app/src/index.js",
    "test": "node --test modules/*/tests/*.test.js shared/*/tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
